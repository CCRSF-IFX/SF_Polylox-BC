/*
 * Polylox-BC Nextflow configuration
 */

params {
    // Input samplesheet: CSV with columns  sample,bam
    input          = "samplesheet.csv"
    outdir         = "results"

    // Resources (ported from config.yaml)
    primers        = "resource/primers.fa"
    whitelist      = "resource/3M-february-2018-REVERSE-COMPLEMENTED.txt.gz"
    lib            = "T-12U-16B"

    // Helper scripts
    extract_script = "scripts/extract_bc.py"
    table_script   = "scripts/table_plots.py"

    // Generic python/pandas container for the custom scripts
    python_container = "quay.io/biocontainers/pandas:1.5.2"
}

// Use Singularity by default; flip to docker with -profile docker
singularity {
    enabled    = true
    autoMounts = true
}

process {
    // Sensible defaults; per-process cpus are set in main.nf
    errorStrategy = 'retry'
    maxRetries    = 1
}

profiles {
    docker {
        singularity.enabled = false
        docker.enabled      = true
    }
    singularity {
        singularity.enabled = true
        docker.enabled      = false
    }
    slurm {
        process.executor = 'slurm'
    }
}

// Provenance reports
report   { enabled = true; file = "${params.outdir}/pipeline_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_trace.txt"; overwrite = true }

manifest {
    name            = 'Polylox-BC'
    description      = 'Iso-Seq barcode extraction pipeline (Nextflow DSL2 port)'
    mainScript       = 'main.nf'
    nextflowVersion  = '>=23.04.0'
    version          = '1.0.0'
}
